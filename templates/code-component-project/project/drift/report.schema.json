{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "siteId", "clean", "warnings", "changes", "mutationPerformed", "sourceBoundary"],
  "properties": {
    "version": { "const": 1 },
    "siteId": { "type": "string" },
    "clean": { "type": "boolean" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "owner", "resolution"],
        "properties": {
          "path": { "type": "string" },
          "owner": { "enum": ["webflow", "shared", "local-release", "unknown"] },
          "resolution": { "enum": ["unresolved", "accept-webflow", "restore-local", "manual"] }
        }
      }
    },
    "mutationPerformed": { "const": false },
    "sourceBoundary": { "type": "string" }
  }
}


   "propertyOverrides": [
    {
     "propertyId": "e2471100-edbc-c38a-5506-2a5e31f55180",
     "type": "Plain Text",
     "label": "Header/Heading",
     "text": {
      "html": null,
      "text": "eva struble"
     }
    },
    {
     "propertyId": "4628f6b7-785d-3e83-9538-04533d608150",
     "type": "Alt Text",
     "label": "Media/Image alt",
     "text": {
      "html": null,
      "text": "Eva Struble seated in front of her paintings"
     }
    },
    {
     "propertyId": "ed8263d8-512d-01db-9908-80de849cc926",
     "type": "Plain Text",
     "label": "Body/Text",
     "text": {
      "html": null,
      "text": "Eva Struble is a San Diego-based artist whose work examines landscape through social, environmental, and personal histories. Her practice explores human-altered environments, regional botany, and the ways nature and human intervention continually reshape one another."
     }
    }
   ]
  },
  {
   "id": "285066ec-e924-16d7-e000-731e947102cb",
   "type": "component-instance",
   "componentId": "44cccc51-37cb-2526-e426-133987071983",
   "propertyOverrides": [
    {
     "propertyId": "e2471100-edbc-c38a-5506-2a5e31f55180",
     "type": "Plain Text",
     "label": "Header/Heading",
     "text": {
      "html": null,
      "text": "‘oceano’"
     }
    },
    {
     "propertyId": "7319d118-d240-ca86-36e8-071c77d6ce26",
     "type": "Plain Text",
     "label": "Header/Eyebrow",
     "text": {
      "html": null,
      "text": "by eva struble"
     }
    },
    {
     "propertyId": "ceef8a78-7413-ed6a-f295-6383f720ad1a",
     "type": "Plain Text",
     "label": "Header/Caption",
     "text": {
      "html": null,
      "text": "2024 | 48 x 60 in\nOil and acrylic on canvas"
     }
    },
    {
     "propertyId": "4628f6b7-785d-3e83-9538-04533d608150",
     "type": "Alt Text",
     "label": "Media/Image alt",
     "text": {
      "html": null,
      "text": "Oceano by Eva Struble, oil and acrylic on canvas"
     }
    },
    {
     "propertyId": "ed8263d8-512d-01db-9908-80de849cc926",
     "type": "Plain Text",
     "label": "Body/Text",
     "text": {
      "html": null,
      "text": "Eva’s work unfolds through layered color, texture, and abstraction, conjuring the atmospheric qualities of a coastal landscape without settling into a singular representation of place. The work speaks to the deep relationship between landscape and the daily life of Southern California, where the natural environment is not simply a backdrop, but integral of how the region is experienced, remembered, and understood."
     }
    }
   ]
  },

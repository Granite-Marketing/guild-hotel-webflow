    {
     "propertyId": "0df84d45-603f-3795-7593-9010ebf7c540",
     "type": "Plain Text",
     "label": "Content/paragraph",
     "text": {
      "html": null,
      "text": "For visitors and locals, Guild dining is a journey, an invitation to to savor our worlds. The Lobby Bar knows its classics from its off-menu surprises. California’s first Zuma serves up the sushi and robata that have made it an international standard-setter from London to Miami, Vail to Abu Dhabi. Poolside, there’s always fresh, easy West Coast goodness, and the Mediterranean influences daytime offerings in The Courtyard."
     }

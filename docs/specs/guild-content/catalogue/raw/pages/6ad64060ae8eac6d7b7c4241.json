     "text": {
      "html": null,
      "text": "the bold, handsome heart of san diego"
     }
    },
    {
     "propertyId": "9fc1aa15-9d65-217e-cbe5-313e53188214",
     "type": "Plain Text",
     "label": "Content/Text",
     "text": {
      "html": null,
      "text": "The Guild is quintessential San Diego, a storied landmark reimagined as a sophisticated playground for locals and visitors alike. Grand and casual, elegant and unexpected, The Guild is an urban resort and destination unlike anything else in the city."
     }
    },
    {
     "propertyId": "2c401db1-96d5-7fbc-68c2-7ea0e151ac56",
     "type": "Plain Text",
     "label": "Content/Heading (Night)",
     "text": {
      "html": null,
      "text": "the bold, handsome heart of san diego after dark"
     }
    },
    {
     "propertyId": "bd5db012-c4b0-6a4e-a0e1-41ffdf3e7bc2",
     "type": "Plain Text",

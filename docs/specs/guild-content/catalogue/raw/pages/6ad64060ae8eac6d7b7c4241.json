     "type": "Plain Text",
     "label": "Content/Heading",
     "text": {
      "html": null,
      "text": "West Coast Hospitality since 1924"
     }
    },
    {
     "propertyId": "3f50e93d-a968-f004-4199-cfd4d1bccba7",
     "type": "Plain Text",
     "label": "Content/Body",
     "text": {
      "html": null,
      "text": "As the YMCA that welcomed Army and Navy men and women, The Guild was the city’s premier gathering place. The experience has been curated, elevated and refined – but at heart, we’re still a sailor on shore leave."
     }
    },
    {
     "propertyId": "2987f69a-50fb-8c63-5d47-1528a05a93b3",
     "type": "Plain Text",
     "label": "Content/CTA label",
     "text": {
      "html": null,
      "text": "uncover our history"
     }
    }
   ]

  {
   "id": "87352ce5-fd3a-7afe-ee2c-97a1b8236605",
   "type": "component-instance",
   "componentId": "bdff66b3-92d9-e1e3-dbc0-86a28e384c9b",
   "propertyOverrides": [
    {
     "propertyId": "96f53ca3-a098-939b-0103-107df27bb4b8",
     "type": "Plain Text",
     "label": "Content/heading",
     "text": {
      "html": null,
      "text": "A century of stories meets a new hospitality"
     }
    },
    {
     "propertyId": "0df84d45-603f-3795-7593-9010ebf7c540",
     "type": "Plain Text",
     "label": "Content/paragraph",
     "text": {
      "html": null,
      "text": "Behind this mannered Italian Renaissance facade is a century of glamorous mischief. Today, it’s an icon with open arms, a high-spirited destination that welcomes you to the heart of contemporary San Diego."
     }
    },
    {
     "propertyId": "4847f1eb-e957-0144-e10e-92569ab9c48a",
     "type": "Alt Text",
     "label": "Image/image alt",

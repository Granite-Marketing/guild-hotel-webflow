     "label": "Content/Heading",
     "text": {
      "html": null,
      "text": "Steps from key legal addresses"
     }
    },
    {
     "propertyId": "b8f3c5b9-efe9-e6a4-5af7-6ab68b883833",
     "type": "Plain Text",
     "label": "Content/Text",
     "text": {
      "html": null,
      "text": "Four courthouses sit within a short walk of The Guild, so your team can move between hearings, prep sessions and the hotel in minutes."

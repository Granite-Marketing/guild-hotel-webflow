    {
     "propertyId": "6641f4cd-e0a1-50a4-7c21-0c2924814323",
     "type": "Rich Text",
     "label": "Items/Item 1 Text",
     "text": {
      "html": "<div><p data-w-id=\"afc0d5cd-9011-87ee-2176-0d24b0ab10e6\">Fast, secure internet throughout the hotel, ideal for managing sensitive documents and conducting virtual proceedings.</p></div>",
      "text": null
     }
    },
    {
     "propertyId": "af838336-9b52-2e13-c029-42ce918a8efd",
     "type": "Rich Text",
     "label": "Items/Item 2 Text",
     "text": {
      "html": "<div><p data-w-id=\"a22e0ca4-59f2-9b7c-f467-66ee11d2e20a\">Professional security protocols maintaining attorney-client privilege standards.</p></div>",
      "text": null
     }
    },
    {
     "propertyId": "7f61040c-583e-d94e-aefd-7c95d13e6849",
     "type": "Rich Text",
     "label": "Items/Item 3 Text",
     "text": {
      "html": "<div><p data-w-id=\"37e39fe1-0f2c-15d1-25f1-be2e73d143a8\">Comfortable, dedicated areas designed for quiet focus and productivity, ideal for reviewing case files, preparing witnesses, and conducting confidential team discussions.</p></div>",
      "text": null
     }
    }
   ]

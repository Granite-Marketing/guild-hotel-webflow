    },
    {
     "propertyId": "c70696b1-fd21-ac07-98a4-dc5d7c2a3d8a",
     "type": "Plain Text",
     "label": "Items/Item 2 Heading",
     "text": {
      "html": null,
      "text": "War Room Setup"
     }
    },
    {
     "propertyId": "d18381ee-348a-4dd0-1bdd-845d3a7c8bd7",
     "type": "Plain Text",
     "label": "Items/Item 3 Heading",

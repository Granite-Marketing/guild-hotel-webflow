   "id": "7078c6ea-16c9-d700-35be-37d4efe7f1ef",
   "type": "html-embed",
   "html": "<style data-legal-rich-text>.static-template-privacy-policy_rich-text>*{margin-top:0;margin-bottom:0;}.static-template-privacy-policy_rich-text>*+*{margin-top:1.625rem;}.static-template-privacy-policy_rich-text p{white-space:pre-line;}.static-template-privacy-policy_rich-text h2,.static-template-privacy-policy_rich-text h3{font-family:var(--_typography---font-styles--heading);font-size:1.25rem;font-weight:900;line-height:1.2;letter-spacing:0;text-transform:lowercase;}.static-template-privacy-policy_rich-text>h2:not(:first-child),.static-template-privacy-policy_rich-text>h3:not(:first-child){margin-top:7rem;}.static-template-privacy-policy_rich-text>h2+*,.static-template-privacy-policy_rich-text>h3+*{margin-top:2.5rem;}.static-template-privacy-policy_rich-text ul,.static-template-privacy-policy_rich-text ol{padding-left:1.75rem;overflow:visible;}.static-template-privacy-policy_rich-text li{margin:0;}.static-template-privacy-policy_rich-text a{color:inherit;text-decoration:underline;}@media (max-width:991px){.static-template-privacy-policy_rich-text>h2:not(:first-child),.static-template-privacy-policy_rich-text>h3:not(:first-child){margin-top:4rem;}}@media (max-width:767px){.static-template-privacy-policy_rich-text>*+*{margin-top:1.25rem;}.static-template-privacy-policy_rich-text>h2:not(:first-child),.static-template-privacy-policy_rich-text>h3:not(:first-child){margin-top:3.5rem;}.static-template-privacy-policy_rich-text>h2+*,.static-template-privacy-policy_rich-text>h3+*{margin-top:1.5rem;}.static-template-privacy-policy_rich-text h2,.static-template-privacy-policy_rich-text h3{font-size:1.125rem;color:#29310c;}}</style>",

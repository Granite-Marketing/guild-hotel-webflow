   "type": "html-embed",
   "html": "<style data-room-template-styles>.rooms-individual-description_list ul{margin:0;padding-left:0;list-style:none;counter-reset:room-detail}.rooms-individual-description_list li{counter-increment:room-detail;display:flex;align-items:flex-start;column-gap:.25rem;padding:.5rem 0;border-bottom:1px solid #29310c4d;font-size:1.125rem;line-height:1.3}.rooms-individual-description_list li:last-child{border-bottom-width:0}.rooms-individual-description_list li::before{content:counter(room-detail);padding-top:.125rem;font-size:.625rem;line-height:1}.rooms-individual-amenities_grid p.rooms-individual-amenities_item{margin:0;border-bottom-width:1px}@media (min-width:992px){.rooms-individual-amenities_column:nth-child(4n+1){border-left-width:0}.rooms-individual-amenities_column:nth-child(4n+1):nth-last-child(-n+4) p.rooms-individual-amenities_item,.rooms-individual-amenities_column:nth-child(4n+1):nth-last-child(-n+4)~.rooms-individual-amenities_column p.rooms-individual-amenities_item{border-bottom-width:0}}@media (min-width:768px) and (max-width:991px){.rooms-individual-amenities_column:nth-child(2n+1):nth-last-child(-n+2) p.rooms-individual-amenities_item,.rooms-individual-amenities_column:nth-child(2n+1):nth-last-child(-n+2)~.rooms-individual-amenities_column p.rooms-individual-amenities_item{border-bottom-width:0}}@media (max-width:767px){.rooms-individual-description_list li{column-gap:.125rem;padding:.75rem 0;font-size:1rem;line-height:1.25}}</style>",

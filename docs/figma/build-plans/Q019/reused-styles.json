{
  "purpose": "Preview only. Approximate values for the reused Relume utilities and the colour and font variables, taken from figma/tokens.json and docs/reference/breakpoints.md, so preview.html renders without the live site. The Designer session uses the live classes; nothing here is created in Webflow.",
  "fontFallbacks": {
    "Morello": "\"Morello\", \"Snell Roundhand\", \"Apple Chancery\", cursive",
    "Sackers Heavy Gothic": "\"Sackers Heavy Gothic\", Copperplate, \"Copperplate Gothic Light\", serif",
    "Gatch Test": "\"Gatch Test\", \"Avenir Next\", Avenir, \"Helvetica Neue\", sans-serif"
  },
  "variables": {
    "color-neutral-100": "#F4EFDF",
    "color-neutral-900": "#262118",
    "color-accent": "#29310C",
    "font-style-heading": "Sackers Heavy Gothic",
    "font-style-body": "Gatch Test"
  },
  "classes": [
    { "name": "padding-global", "styles": { "desktop": { "padding-left": "2rem", "padding-right": "2rem" } } },
    { "name": "padding-section-large", "styles": {
      "desktop": { "padding-top": "7rem", "padding-bottom": "7rem" },
      "tablet": { "padding-top": "5rem", "padding-bottom": "5rem" },
      "mobileLandscape": { "padding-top": "3.5rem", "padding-bottom": "3.5rem" },
      "mobilePortrait": { "padding-top": "2.5rem", "padding-bottom": "2.5rem" } } },
    { "name": "container-large", "styles": { "desktop": { "width": "100%", "max-width": "80rem", "margin-left": "auto", "margin-right": "auto" } } },
    { "name": "heading-style-h1", "styles": { "desktop": { "margin": "0", "font-family": "var(--font-style-heading)", "font-size": "3.5rem", "line-height": "1", "text-transform": "lowercase" } } },
    { "name": "heading-style-h2", "styles": { "desktop": { "margin": "0", "font-family": "var(--font-style-heading)", "font-size": "2.5rem", "line-height": "1", "letter-spacing": "-0.05em" }, "mobileLandscape": { "font-size": "2rem" } } },
    { "name": "heading-style-h4", "styles": { "desktop": { "margin": "0", "font-family": "var(--font-style-heading)", "font-size": "1.5rem", "line-height": "1.2", "text-transform": "lowercase" } } },
    { "name": "text-weight-normal", "styles": { "desktop": { "font-weight": "400" } } },
    { "name": "text-size-medium", "styles": { "desktop": { "font-size": "1.25rem", "line-height": "1.3" } } },
    { "name": "text-size-regular", "styles": { "desktop": { "font-size": "1rem", "line-height": "1.5" } } },
    { "name": "button", "styles": { "desktop": { "padding": "0.75rem 1.5rem", "border": "1px solid #000", "background-color": "#000", "color": "#fff", "text-decoration": "none" } } }
  ]
}

  "proposedShared": [
    {
      "name": "is-chamfer",
      "why": "Cream chamfered (octagonal) button used by this CTA and, from figma/vectors (vector-25-* shapes, 19 sizes), most buttons site-wide. Combo on the Relume `button` base.",
      "on": "button",
      "styles": {
        "desktop": {
          "display": "inline-flex",
          "justify-content": "center",
          "align-items": "center",
          "min-height": "2.3125rem",
          "padding": "0.5625rem 2.3125rem",
          "border": "0",
          "border-radius": "0",
          "background-color": "var(--color-neutral-100)",
          "color": "var(--color-brand-4a1217)",
          "text-align": "center",
          "text-decoration": "none",
          "cursor": "pointer",
          "clip-path": "polygon(0.6875rem 0, calc(100% - 0.6875rem) 0, 100% 32.35%, 100% 67.13%, calc(100% - 0.6875rem) 100%, 0.6875rem 100%, 0 67.13%, 0 32.35%)",
          "font-family": "var(--font-style-heading)",
          "font-size": "1rem",
          "line-height": "1.2",
          "letter-spacing": "-0.03em",
          "text-transform": "lowercase",
          "font-weight": "400"
        }
      }
    },
    {
      "name": "is-wide",
      "why": "Wider fixed-minimum button (book now is 214px against 144px for join us at the same padding). Combo on `button is-chamfer`.",
      "on": "button is-chamfer",
      "styles": {
        "desktop": {
          "min-width": "13.375rem"
        }
      }
    },
    {
      "name": "text-style-caption",
      "why": "Sackers 14/14/0.7 lowercase caption: 648 uses in figma/tokens.json textStyles; tokens mapping suggests this combo name.",
      "styles": {
        "desktop": {
          "font-family": "var(--font-style-heading)",
          "font-size": "0.875rem",
          "line-height": "1",
          "letter-spacing": "0.05em",
          "text-transform": "lowercase",
          "font-weight": "400"
        }
      }
    }
  ],

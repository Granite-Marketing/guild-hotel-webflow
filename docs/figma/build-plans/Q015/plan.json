        }
      }
    },
    {
      "name": "accordion_icon",
      "why": "Chevron wrapper (figure-style wrapper for the inline SVG); rotates with the header state",
      "styles": {
        "desktop": {
          "display": "flex",
          "width": "1.5rem",
          "height": "1.5rem",
          "flex-shrink": "0",
          "transform": "rotate(180deg)",
          "transition": "transform 300ms ease"
        }
      },
      "states": {
        "accordion_header.is-active": {
          "transform": "rotate(0deg)"

    },
    {
      "id": "309:593",
      "characters": "3 A Hotel team member will be available to you throughout the shoot and will provide entrance to the pre-determined available areas of the Hotel. As a result, a location flat fee of $500 will apply.",
      "styleName": "Paragraph",
      "styleId": "236:8094",
      "fontFamily": "Gatch Test",
      "fontSize": 20,
      "fontWeight": 400,
      "lineHeightPx": 26,

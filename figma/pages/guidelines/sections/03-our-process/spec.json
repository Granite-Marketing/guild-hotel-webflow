    },
    {
      "id": "309:592",
      "characters": "2 Room rental charges may apply (in addition to the location fee) to reserve spaces to shoot in.",
      "styleName": "Paragraph",
      "styleId": "236:8094",
      "fontFamily": "Gatch Test",

      }
    },
    {
      "id": "309:595",
      "characters": "4 Shooting in public areas of the Hotel (including, but not limited to front steps, The Lobby Bar, The Lobby Terrace, Pool Lounge, Zuma) are not guaranteed, and may be limited.",
      "styleName": "Paragraph",
      "styleId": "236:8094",
      "fontFamily": "Gatch Test",
      "fontSize": 20,
      "fontWeight": 400,
      "lineHeightPx": 26,

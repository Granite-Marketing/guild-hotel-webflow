    {
      "id": "309:573",
      "characters": "To ensure the best experience during your shoot, and to optimize Hotel guest experience, the following guidelines apply for professional shoots:",
      "styleName": "Paragraph",
      "styleId": "236:8094",
      "fontFamily": "Gatch Test",
      "fontSize": 20,
